+impl MemoryDat {
+    fn new() -> Self {
+        Self { chunks: Vec::new(), len: 0, pos: 0 }
+    }
+
+    /// Room for `len` bytes; new pieces are zeroed.
+    fn reserve_to(&mut self, len: u64) -> std::io::Result<()> {
+        while ((self.chunks.len() * CHUNK) as u64) < len {
+            let mut chunk = Vec::new();
+            chunk.try_reserve_exact(CHUNK).map_err(|_| out_of_memory())?;
+            chunk.resize(CHUNK, 0);
