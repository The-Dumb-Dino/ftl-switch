+++ b/src/switch_lib.rs
@@ -0,0 +1,176 @@
+#![feature(offset_of_enum)]
+#![feature(iter_order_by)]
+#![allow(dead_code, unused_imports)]
+// ftlman's patching, linked into ftl.nro (the Switch port of FTL for iPad): the same
+// code as `ftlman patch`, called from C. No window, no updater, no Hyperspace
+// installer: ftl.nro brings its own Hyperspace.
+
+include!("main.rs");
+
+mod switch_api {
+    use std::ffi::{CStr, c_char};
+    use std::path::PathBuf;
+
+    use crate::{Mod, ModSource};
+
+    type LogFn = extern "C" fn(level: i32, msg: *const c_char);
+
+    struct CLogger(LogFn);
+    impl log::Log for CLogger {
+        fn enabled(&self, m: &log::Metadata) -> bool {
+            m.level() <= log::Level::Info
+        }
+        fn log(&self, r: &log::Record) {
+            if !self.enabled(r.metadata()) {
+                return;
+            }
+            let level = match r.level() {
+                log::Level::Error => 2,
+                log::Level::Warn => 1,
+                _ => 0,
+            };
+            let msg = format!("ftlman: {}\0", r.args());
+            (self.0)(level, msg.as_ptr() as *const c_char);
+        }
+        fn flush(&self) {}
+    }
+
+    /// At most how much memory patching in memory needs: ftl.dat.vanilla (or
+    /// ftl.dat before the first patch) and everything the mods hold unpacked.
+    fn memory_needed(data_dir: &std::path::Path, paths: &[PathBuf]) -> std::io::Result<u64> {
+        let vanilla = data_dir.join("ftl.dat.vanilla");
+        let dat = if vanilla.exists() { vanilla } else { data_dir.join("ftl.dat") };
+        let mut total = std::fs::metadata(dat)?.len();
+        for path in paths {
+            total += if path.is_dir() {
+                fn dir_size(p: &std::path::Path) -> std::io::Result<u64> {
+                    let mut n = 0;
+                    for e in std::fs::read_dir(p)? {
+                        let e = e?;
+                        let m = e.metadata()?;
+                        n += if m.is_dir() { dir_size(&e.path())? } else { m.len() };
+                    }
+                    Ok(n)
+                }
+                dir_size(path)?
+            } else {
+                // the sizes from the zip's directory alone: opening each file would
+                // read its header, all over the zip
+                let file = std::fs::File::open(path)?;
+                let packed = file.metadata()?.len();
+                let zip = zip::ZipArchive::new(crate::SeekBuf::new(file)).map_err(std::io::Error::other)?;
+                zip.decompressed_size().map_or(packed * 2, |n| n as u64)
+            };
+        }
+        // the result is smaller (replaced files, the repack): this only rules out
+        // what can't fit; the copy takes what it needs, in pieces
+        Ok(total + (64 << 20))
+    }
+
+    fn out_of_memory(e: &anyhow::Error) -> bool {
+        // silpkg's errors may not pass the io::Error on as a source: the message says it too
+        format!("{e:#}").contains("not enough memory for ftl.dat")
+            || e.chain().any(|c| {
+                c.downcast_ref::<std::io::Error>()
+                    .is_some_and(|io| io.kind() == std::io::ErrorKind::OutOfMemory)
+            })
+    }
+
+    /// Patches data_dir/ftl.dat with the n mods (paths to .ftl/.zip files or
+    /// folders), starting from data_dir/ftl.dat.vanilla (made on the first run), as
+    /// `ftlman patch` does. With memory (bytes ftlman may use) for a copy of
+    /// ftl.dat and the mods, it patches that copy and writes ftl.dat once at the
+    /// end; otherwise, or when memory runs out on the way, it patches ftl.dat on
+    /// the SD card (slow). log gets
+    /// ftlman's messages; on failure the reason is written to err. Returns 0 on
+    /// success.
+    #[unsafe(no_mangle)]
+    pub extern "C" fn ftlman_patch(
+        data_dir: *const c_char,
+        mods: *const *const c_char,
+        n: usize,
+        memory: usize,
+        log: Option<LogFn>,
+        err: *mut c_char,
+        errlen: usize,
+    ) -> i32 {
+        if let Some(f) = log {
+            static LOGGER: std::sync::OnceLock<CLogger> = std::sync::OnceLock::new();
+            if log::set_logger(LOGGER.get_or_init(|| CLogger(f))).is_ok() {
+                log::set_max_level(log::LevelFilter::Info);
+            }
+        }
+        let cstr = |p: *const c_char| unsafe { CStr::from_ptr(p) }.to_string_lossy().into_owned();
+        let data_dir = PathBuf::from(cstr(data_dir));
+        let paths: Vec<PathBuf> = (0..n).map(|i| PathBuf::from(cstr(unsafe { *mods.add(i) }))).collect();
+        let make_mods = || -> Vec<Mod> {
+            paths
+                .iter()
+                .map(|path| {
+                    let path = path.clone();
+                    let source = if path.is_dir() { ModSource::Directory { path } } else { ModSource::Zip { path } };
+                    Mod::new_with_enabled(source, true)
+                })
+                .collect()
+        };
+        let apply = |in_memory: Option<u64>| {
+            let mut diagnostics = crate::validate::Diagnostics::new();
+            crate::apply::apply_ftl_with(
+                &data_dir,
+                make_mods(),
+                |stage| match stage {
+                    crate::apply::ApplyStage::Preparing => log::info!("Preparing..."),
+                    crate::apply::ApplyStage::Repacking => log::info!("Repacking..."),
+                    _ => {}
+                },
+                // always: without the repack silpkg 0.1.4 leaves a broken path table when it
+                // had to grow it (it copies the table onto itself)
+                true,
+                Some(&mut diagnostics),
+                false,
+                in_memory,
+            )
+        };
+
+        let started = std::time::Instant::now();
+        let needed = memory_needed(&data_dir, &paths);
+        let result = match needed {
+            Ok(need) if need <= memory as u64 => {
+                log::info!("Patching in memory (up to {} MB of {} MB free)", need >> 20, memory >> 20);
+                match apply(Some(need)) {
+                    Err(e) if out_of_memory(&e) => {
+                        log::warn!("Ran out of memory ({e:#}): patching on the SD card instead");
+                        apply(None)
+                    }
+                    r => r,
+                }
+            }
+            Ok(need) => {
+                log::info!("Patching on the SD card (needs {} MB of memory, {} MB free)", need >> 20, memory >> 20);
+                apply(None)
+            }
+            Err(e) => {
+                log::warn!("Couldn't size the mods ({e}): patching on the SD card");
+                apply(None)
+            }
+        };
+        if result.is_ok() {
+            log::info!("Patched in {:.0} s", started.elapsed().as_secs_f32());
+        }
+        match result {
+            Ok(()) => 0,
+            Err(e) => {
+                let msg = format!("{e:#}");
+                if !err.is_null() && errlen > 0 {
+                    let b = msg.as_bytes();
+                    let k = b.len().min(errlen - 1);
+                    unsafe {
+                        std::ptr::copy_nonoverlapping(b.as_ptr(), err as *mut u8, k);
+                        *err.add(k) = 0;
+                    }
+                }
+                1
+            }
+        }
+    }
+}
