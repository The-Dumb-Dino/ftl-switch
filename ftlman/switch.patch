+/// A read buffer (1 MB) that, unlike BufReader, keeps its data when a seek lands
+/// inside it: the zip reader jumps to every file's header, and files follow each
+/// other, so most jumps stay in the buffer. Reads of a buffer or more go direct.
+pub struct SeekBuf<R> {
+    inner: R,
+    buf: Vec<u8>,
+    start: u64,      // file offset of buf[0]
+    len: usize,      // valid bytes in buf
+    pos: u64,        // where the next read starts
+    inner_pos: u64,  // where inner is
+}
+
+impl<R: Read + Seek> SeekBuf<R> {
+    pub fn new(inner: R) -> Self {
+        Self { inner, buf: vec![0; 1 << 20], start: 0, len: 0, pos: 0, inner_pos: 0 }
+    }
+
+    fn inner_to(&mut self, pos: u64) -> std::io::Result<()> {
+        if self.inner_pos != pos {
+            self.inner.seek(std::io::SeekFrom::Start(pos))?;
+            self.inner_pos = pos;
+        }
+        Ok(())
+    }
+}
+
+impl<R: Read + Seek> Read for SeekBuf<R> {
+    fn read(&mut self, out: &mut [u8]) -> std::io::Result<usize> {
+        let end = self.start + self.len as u64;
+        if self.pos < self.start || self.pos >= end {
+            if out.len() >= self.buf.len() {
+                self.inner_to(self.pos)?;
+                let n = self.inner.read(out)?;
+                self.inner_pos += n as u64;
+                self.pos += n as u64;
+                return Ok(n);
+            }
+            self.inner_to(self.pos)?;
+            let n = self.inner.read(&mut self.buf)?;
+            self.inner_pos += n as u64;
+            self.start = self.pos;
+            self.len = n;
+            if n == 0 {
+                return Ok(0);
+            }
+        }
+        let at = (self.pos - self.start) as usize;
+        let n = out.len().min(self.len - at);
+        out[..n].copy_from_slice(&self.buf[at..at + n]);
+        self.pos += n as u64;
+        Ok(n)
+    }
+}
+
+impl<R: Read + Seek> Seek for SeekBuf<R> {
+    fn seek(&mut self, to: std::io::SeekFrom) -> std::io::Result<u64> {
+        self.pos = match to {
+            std::io::SeekFrom::Start(n) => n,
+            std::io::SeekFrom::Current(d) => self
+                .pos
+                .checked_add_signed(d)
+                .ok_or(std::io::Error::from(std::io::ErrorKind::InvalidInput))?,
+            std::io::SeekFrom::End(_) => {
+                let p = self.inner.seek(to)?;
+                self.inner_pos = p;
+                p
+            }
+        };
+        Ok(self.pos)
+    }
+}
+
 pub trait ReadSeek: Read + Seek {}
 impl<T: Read + Seek> ReadSeek for T {}
 
