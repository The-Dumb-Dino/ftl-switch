+        while done < buf.len() {
+            let at = self.pos as usize + done;
+            let (c, o) = (at / CHUNK, at % CHUNK);
+            let n = (buf.len() - done).min(CHUNK - o);
+            self.chunks[c][o..o + n].copy_from_slice(&buf[done..done + n]);
+            done += n;
+        }
+        self.pos = end;
+        self.len = self.len.max(end);
